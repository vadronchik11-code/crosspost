# ---------- Вход на сайт ----------
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me
# Любая длинная случайная строка (подписывает cookie сессии). Можно не задавать.
SECRET_KEY=

# ---------- VK ----------
# Токен пользователя (права: wall, photos, groups, offline) или токен сообщества (права: wall, photos)
VK_TOKEN=
# ID сообщества без минуса, например 123456789
VK_GROUP_ID=

# ---------- Telegram ----------
TG_BOT_TOKEN=
# @username канала или числовой id вида -1001234567890
TG_CHAT_ID=

# Аккаунт пользователя Telegram (админ канала) – нужен для отложки на серверах Telegram:
# my.telegram.org → API development tools → api_id и api_hash. Вход по телефону делается на сайте (Команда → Telegram).
TG_API_ID=
TG_API_HASH=
# MTProto-прокси для этого аккаунта (ссылка tg://proxy?server=...&port=...&secret=...). Пусто – напрямую/через TG_PROXY.
TG_MTPROXY=

# ---------- VPN только для Telegram ----------
# Вариант 1: vless-ссылка — приложение само запустит xray-core
TG_VLESS=
# Вариант 2: готовый прокси (например от v2rayN/Hiddify на этом ПК): socks5://127.0.0.1:10808
# tg://proxy?... (MTProto) сюда НЕ подходит – он только для клиента Telegram, бот ходит по HTTPS.
# Вариант 3: VPN включён на всём ПК – оставь TG_VLESS и TG_PROXY пустыми.
TG_PROXY=
# Путь к бинарнику xray (необязательно; по умолчанию ищется ./xray/xray(.exe) или в PATH)
XRAY_BIN=
XRAY_SOCKS_PORT=10808

# ---------- Сервер ----------
HOST=0.0.0.0
PORT=8000
